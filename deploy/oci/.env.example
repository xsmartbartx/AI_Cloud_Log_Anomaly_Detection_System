# Copy to .env on the VM (chmod 600). Never commit it.

# Public host name, must already point at this VM
LINEGIST_HOST=linegist.onenexora.com

# Database. Use a long random value without special characters:  openssl rand -hex 24
POSTGRES_PASSWORD=
PG_POOL_MAX=10

# Clerk (production instance; sign-in is shared with account.onenexora.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=https://account.onenexora.com/sign-in

# Stripe (live keys only at go-live)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTH=
STRIPE_PRICE_STARTER_YEAR=
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
STRIPE_PRICE_BUSINESS_MONTH=
STRIPE_PRICE_BUSINESS_YEAR=
STRIPE_PRICE_SCALE_MONTH=
STRIPE_PRICE_SCALE_YEAR=

# Shared secrets:  openssl rand -hex 32
CRON_SECRET=
CONSOLE_SHARED_SECRET=
